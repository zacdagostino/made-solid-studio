VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# Dedicated private preview host. When omitted, Studio uses the legacy sandboxed preview shell.
VITE_SITEFORGE_PREVIEW_ORIGIN=https://preview.example.com
# Set this only for offline development or browser tests. Omit in deployed environments.
# VITE_SITEFORGE_STORAGE=local

# Protected background workers. Keep the service role and shared secret server-only.
SITEFORGE_SUPABASE_URL=https://your-project-ref.supabase.co
SITEFORGE_SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Website builds use the trusted worker's cached ChatGPT subscription sign-in by default.
SITEFORGE_CODEX_AUTH_MODE=chatgpt
# Codex Workspace Agent, Website Builder and Test Builder reject API-key mode.
# Separately billed OpenAI Analysis Workers are fail-closed unless both flags are true.
SITEFORGE_OPENAI_API_ENABLED=false
VITE_SITEFORGE_OPENAI_API_ENABLED=false
# Only configure these after explicitly enabling separately billed analysis.
# OPENAI_API_KEY=your_server_only_openai_key
# SITEFORGE_UX_VISION_API_KEY=your_server_only_openai_key
# SITEFORGE_UX_VISION_MODEL=gpt-5.4
MADE_SOLID_HANDOFF_URL=https://madesolid.com.au/api/integrations/studio/handoffs
MADE_SOLID_HANDOFF_SECRET=use_the_same_long_random_secret_as_the_website
# Preferred explicit endpoint for private, pre-handoff report previews. When omitted, the worker
# derives it by replacing the terminal /handoffs segment in MADE_SOLID_HANDOFF_URL.
MADE_SOLID_REPORT_PREVIEW_URL=https://madesolid.com.au/api/integrations/studio/report-previews
# The exact-commit handoff deploys through the server-only Vercel CLI session.
VERCEL_TEAM_SLUG=made-solid
VERCEL_CLI_VERSION=58.9.2
MADE_SOLID_PROSPECT_DOMAIN=madesolid.com.au
SITEFORGE_PROSPECT_WORKSPACES_DIR=/absolute/path/to/prospect-workspaces

# Permanent Railway runtime. These are server-only except for the VITE_* build variables above.
SITEFORGE_RUNTIME_AUTH_REQUIRED=1
SITEFORGE_RUNTIME_OWNER_USER_ID=your_owner_user_uuid
SITEFORGE_RUNTIME_OWNER_ORGANIZATION_ID=your_owner_organization_uuid
SITEFORGE_RUNTIME_DATA_DIR=/data
SITEFORGE_PUBLIC_ORIGIN=https://studio.example.com
PREVIEW_PUBLIC_ORIGIN=https://preview.example.com
SITEFORGE_WORKSPACE_PREVIEW_ORIGIN=https://workspace.example.com
# Leave this unset on Railway to generate and persist a private value on the /data volume.
# SITEFORGE_WORKSPACE_PREVIEW_SECRET=at_least_32_random_characters
SITEFORGE_STUDIO_REPOSITORY=zacdagostino/made-solid-studio
SITEFORGE_WEBSITE_REPOSITORY=zacdagostino/made-solid-website
SITEFORGE_GITHUB_TOKEN=your_fine_grained_github_token
SITEFORGE_PREVIEW_PORT=8787
SITEFORGE_WORKSPACE_PROXY_PORT=3000
# Optional private Google Chirp 3 HD read-aloud. Enable Cloud Text-to-Speech and billing, create a
# least-privilege service account with Text-to-Speech access, then store its complete JSON key as
# one server-only Railway secret. Never expose this through a VITE_* variable.
# SITEFORGE_GOOGLE_TTS_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
