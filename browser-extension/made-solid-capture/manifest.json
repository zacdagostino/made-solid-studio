{
  "manifest_version": 3,
  "name": "Made Solid Studio Capture",
  "description": "Captures the visible Made Solid Studio tab for local Codex feedback without opening the desktop-sharing chooser.",
  "version": "0.2.0",
  "permissions": ["tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*", "https://*.app.github.dev/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
