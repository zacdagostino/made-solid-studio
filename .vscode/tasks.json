{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Open persistent Codespace terminal",
      "type": "shell",
      "command": "bash \"${workspaceFolder}/scripts/codespace-work\"",
      "runOptions": {
        "runOn": "folderOpen",
        "instanceLimit": 1,
        "instancePolicy": "silent"
      },
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": false,
        "close": false,
        "showReuseMessage": false
      },
      "problemMatcher": []
    }
  ]
}
