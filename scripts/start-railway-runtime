#!/usr/bin/env bash

set -euo pipefail

application_directory="$(cd "$(dirname "$0")/.." && pwd)"
runtime_data_directory="${SITEFORGE_RUNTIME_DATA_DIR:-/data}"
runtime_directory="$runtime_data_directory/runtime"
workspace_vite_cache_directory="$runtime_directory/workspace-vite-cache"
workspace_root="${SITEFORGE_RUNTIME_WORKSPACES_DIR:-$runtime_data_directory/workspaces}"
studio_workspace_directory="$workspace_root/siteforge-os"
prospect_workspaces_directory="$runtime_data_directory/prospect-workspaces"
codex_home_directory="$runtime_data_directory/codex"
preview_secret_file="$runtime_directory/workspace-preview-secret"
port="${PORT:-8080}"
workspace_gateway_port="${SITEFORGE_WORKSPACE_PROXY_PORT:-3000}"
workspace_studio_port="${SITEFORGE_WORKSPACE_STUDIO_PORT:-5173}"
development_origin="${SITEFORGE_DEVELOPMENT_ORIGIN:-${SITEFORGE_WORKSPACE_PREVIEW_ORIGIN:-}}"

if [[ -z "$development_origin" ]]; then
  echo "SITEFORGE_DEVELOPMENT_ORIGIN or SITEFORGE_WORKSPACE_PREVIEW_ORIGIN is required."
  exit 1
fi

for port_configuration in \
  "PORT:$port" \
  "SITEFORGE_WORKSPACE_PROXY_PORT:$workspace_gateway_port" \
  "SITEFORGE_WORKSPACE_STUDIO_PORT:$workspace_studio_port"; do
  port_name="${port_configuration%%:*}"
  port_value="${port_configuration#*:}"
  if [[ ! "$port_value" =~ ^[0-9]+$ ]] || ((port_value < 1 || port_value > 65535)); then
    echo "$port_name must be a valid TCP port."
    exit 1
  fi
done
if [[ "$port" == "$workspace_gateway_port" || "$port" == "$workspace_studio_port" || "$workspace_gateway_port" == "$workspace_studio_port" ]]; then
  echo "Production Studio, Workspace gateway, and Workspace Vite must use distinct ports."
  exit 1
fi
for required_name in \
  SITEFORGE_SUPABASE_URL \
  SITEFORGE_SUPABASE_SERVICE_ROLE_KEY \
  SITEFORGE_RUNTIME_OWNER_USER_ID \
  SITEFORGE_RUNTIME_OWNER_ORGANIZATION_ID; do
  if [[ -z "${!required_name:-}" ]]; then
    echo "$required_name is required by the Railway Studio runtime."
    exit 1
  fi
done

mkdir -p \
  "$runtime_directory" \
  "$workspace_vite_cache_directory" \
  "$prospect_workspaces_directory" \
  "$codex_home_directory"

if [[ -e "$application_directory/prospect-workspaces" && ! -L "$application_directory/prospect-workspaces" ]]; then
  echo "$application_directory/prospect-workspaces must be a symlink in the Railway image."
  exit 1
fi
ln -sfn "$prospect_workspaces_directory" "$application_directory/prospect-workspaces"

if [[ -n "${SITEFORGE_GITHUB_TOKEN:-}" ]]; then
  export GH_TOKEN="$SITEFORGE_GITHUB_TOKEN"
elif [[ -n "${GITHUB_TOKEN:-}" ]]; then
  export GH_TOKEN="$GITHUB_TOKEN"
fi
"$application_directory/scripts/bootstrap-railway-workspaces"

if [[ ! -f "$studio_workspace_directory/package.json" || ! -f "$studio_workspace_directory/vite.config.ts" ]]; then
  echo "The persistent Studio workspace is incomplete at $studio_workspace_directory."
  exit 1
fi

# The image owns the locked production dependencies while the persistent checkout owns the editable
# Studio source. Make those dependencies available to Vite without overwriting a workspace-managed
# node_modules directory.
if [[ ! -e "$studio_workspace_directory/node_modules" ]]; then
  ln -s "$application_directory/node_modules" "$studio_workspace_directory/node_modules"
fi

if [[ -z "${SITEFORGE_WORKSPACE_PREVIEW_SECRET:-}" ]]; then
  if [[ ! -s "$preview_secret_file" ]]; then
    PREVIEW_SECRET_FILE="$preview_secret_file" node --input-type=module -e \
      "import { randomBytes } from 'node:crypto'; import { writeFileSync } from 'node:fs'; writeFileSync(process.env.PREVIEW_SECRET_FILE, randomBytes(48).toString('base64url'), { mode: 0o600 });"
  fi
  SITEFORGE_WORKSPACE_PREVIEW_SECRET="$(<"$preview_secret_file")"
  export SITEFORGE_WORKSPACE_PREVIEW_SECRET
fi

export NODE_ENV=production
export SITEFORGE_RUNTIME_AUTH_REQUIRED=1
export SITEFORGE_RUNTIME_DATA_DIR="$runtime_data_directory"
export SITEFORGE_RUNTIME_WORKSPACES_DIR="$workspace_root"
export SITEFORGE_STUDIO_WORKSPACE_DIR="$workspace_root/siteforge-os"
export MADE_SOLID_WEBSITE_DIRECTORY="$workspace_root/made-solid-website"
export SITEFORGE_PROSPECT_WORKSPACES_DIR="$prospect_workspaces_directory"
export SITEFORGE_CODEX_HOME="$codex_home_directory"
export CODEX_HOME="$codex_home_directory"
export SITEFORGE_ACTIVE_PREVIEW_PATH="$runtime_directory/active-preview.json"
export SITEFORGE_PREVIEW_PORT="${SITEFORGE_PREVIEW_PORT:-8787}"
export SITEFORGE_WORKSPACE_PROXY_PORT="$workspace_gateway_port"
export SITEFORGE_WORKSPACE_STUDIO_PORT="$workspace_studio_port"
export SITEFORGE_DEVELOPMENT_ORIGIN="$development_origin"
export SITEFORGE_CODEX_AUTH_MODE=runtime
export SUPABASE_URL="${SUPABASE_URL:-$SITEFORGE_SUPABASE_URL}"
export SUPABASE_SERVICE_ROLE_KEY="${SUPABASE_SERVICE_ROLE_KEY:-$SITEFORGE_SUPABASE_SERVICE_ROLE_KEY}"
unset CODEX_API_KEY

if ! node "$application_directory/scripts/restore-active-workspace-preview.mjs"; then
  echo "[railway-runtime] Saved workspace restart failed; Studio will retry after owner access."
fi

declare -a child_processes=()
declare -a critical_processes=()
stopping=0

stop_runtime() {
  if ((stopping)); then return; fi
  stopping=1
  for child in "${child_processes[@]}"; do
    kill -TERM "$child" 2>/dev/null || true
  done
  wait || true
}

maintain_codex_app_server() {
  while true; do
    started_mode="$(node "$application_directory/scripts/runtime-ai-billing.mjs")"
    "$application_directory/scripts/start-codex-app-server" &
    codex_process=$!
    while kill -0 "$codex_process" 2>/dev/null; do
      sleep 2
      current_mode="$(node "$application_directory/scripts/runtime-ai-billing.mjs")"
      if [[ "$current_mode" != "$started_mode" ]]; then
        echo "[railway-runtime] AI billing mode changed; restarting the Codex Workspace Agent."
        kill -TERM "$codex_process" 2>/dev/null || true
        break
      fi
    done
    wait "$codex_process" 2>/dev/null || true
    sleep 2
  done
}

maintain_workspace_studio() {
  local workspace_process=''
  local health_process=''
  local workspace_stopping=0
  trap 'workspace_stopping=1; [[ -z "$health_process" ]] || kill -TERM "$health_process" 2>/dev/null || true; [[ -z "$workspace_process" ]] || kill -TERM "$workspace_process" 2>/dev/null || true' INT TERM
  while ((workspace_stopping == 0)); do
    (
      cd "$studio_workspace_directory"
      exec env -i \
        PATH="$PATH" \
        SITEFORGE_PUBLIC_ORIGIN="$development_origin" \
        SITEFORGE_DEVELOPMENT_ORIGIN="$development_origin" \
        SITEFORGE_DEVELOPMENT_COMPATIBILITY_ORIGINS="${SITEFORGE_DEVELOPMENT_COMPATIBILITY_ORIGINS:-}" \
        SITEFORGE_RUNTIME_DATA_DIR="$runtime_data_directory" \
        SITEFORGE_VITE_CACHE_DIR="$workspace_vite_cache_directory" \
        SITEFORGE_RUNTIME_API_PROXY_ORIGIN="http://127.0.0.1:$port" \
        SITEFORGE_STUDIO_WORKSPACE_DIR="$studio_workspace_directory" \
        SITEFORGE_PROSPECT_WORKSPACES_DIR="$prospect_workspaces_directory" \
        MADE_SOLID_WEBSITE_DIRECTORY="$workspace_root/made-solid-website" \
        SITEFORGE_WORKSPACE_DEVELOPMENT=1 \
        SITEFORGE_WORKSPACE_PREVIEW_ORIGIN="${SITEFORGE_WORKSPACE_PREVIEW_ORIGIN:-$development_origin}" \
        VITE_SITEFORGE_OPENAI_API_ENABLED=false \
        VITE_SITEFORGE_DEVELOPMENT_ORIGIN="$development_origin" \
        VITE_SITEFORGE_DEVELOPMENT_COMPATIBILITY_ORIGINS="${SITEFORGE_DEVELOPMENT_COMPATIBILITY_ORIGINS:-}" \
        VITE_SITEFORGE_PREVIEW_ORIGIN="${VITE_SITEFORGE_PREVIEW_ORIGIN:-}" \
        VITE_SUPABASE_PUBLISHABLE_KEY="${VITE_SUPABASE_PUBLISHABLE_KEY:-}" \
        VITE_SUPABASE_URL="${VITE_SUPABASE_URL:-}" \
        node "$application_directory/node_modules/vite/bin/vite.js" \
          --config "$studio_workspace_directory/vite.config.ts" \
          --mode development \
          --host 127.0.0.1 \
          --port "$workspace_studio_port" \
          --strictPort
    ) &
    workspace_process=$!
    (
      failures=0
      sleep 8
      while kill -0 "$workspace_process" 2>/dev/null; do
        if curl --fail --silent --show-error --max-time 5 \
          "http://127.0.0.1:$workspace_studio_port/@vite/client" >/dev/null 2>&1 && \
          curl --fail --silent --show-error --max-time 5 \
          "http://127.0.0.1:$workspace_studio_port/node_modules/.vite/deps/react.js" >/dev/null 2>&1; then
          failures=0
        else
          failures=$((failures + 1))
          if ((failures >= 4)); then
            echo "[railway-runtime] Workspace Studio dependency graph is unhealthy; restarting it from the isolated serve cache."
            kill -TERM "$workspace_process" 2>/dev/null || true
            break
          fi
        fi
        sleep 5
      done
    ) &
    health_process=$!
    wait "$workspace_process" 2>/dev/null || true
    kill -TERM "$health_process" 2>/dev/null || true
    wait "$health_process" 2>/dev/null || true
    health_process=''
    workspace_process=''
    if ((workspace_stopping == 0)); then
      echo "[railway-runtime] Workspace Studio stopped; production remains available while it restarts."
      sleep 2
    fi
  done
}

maintain_workspace_gateway() {
  local gateway_process=''
  local gateway_stopping=0
  trap 'gateway_stopping=1; [[ -z "$gateway_process" ]] || kill -TERM "$gateway_process" 2>/dev/null || true' INT TERM
  while ((gateway_stopping == 0)); do
    node "$application_directory/scripts/workspace-studio-gateway.mjs" &
    gateway_process=$!
    wait "$gateway_process" 2>/dev/null || true
    gateway_process=''
    if ((gateway_stopping == 0)); then
      echo "[railway-runtime] Workspace owner gateway stopped; production remains available while it restarts."
      sleep 2
    fi
  done
}

trap stop_runtime INT TERM EXIT

(
  cd "$application_directory"
  exec node "$application_directory/node_modules/vite/bin/vite.js" preview \
    --config "$application_directory/vite.config.ts" \
    --host 0.0.0.0 \
    --port "$port" \
    --strictPort
) &
child_processes+=("$!")
critical_processes+=("$!")

node "$application_directory/worker/supervisor.mjs" &
child_processes+=("$!")
critical_processes+=("$!")

node "$application_directory/preview-host/server.mjs" &
child_processes+=("$!")
critical_processes+=("$!")

maintain_workspace_studio &
child_processes+=("$!")

maintain_workspace_gateway &
child_processes+=("$!")

maintain_codex_app_server &
child_processes+=("$!")
critical_processes+=("$!")

echo "[railway-runtime] Production Studio is starting from the reviewed image on port $port."
echo "[railway-runtime] Editable Workspace Studio is starting from $studio_workspace_directory behind the owner gateway on port $workspace_gateway_port."
set +e
wait -n "${critical_processes[@]}"
exit_code=$?
set -e
echo "[railway-runtime] a required runtime process stopped; shutting down for a clean restart."
stop_runtime
trap - EXIT
exit "$exit_code"
