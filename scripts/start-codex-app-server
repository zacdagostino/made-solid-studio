#!/usr/bin/env bash

set -euo pipefail

project_directory="$(cd "$(dirname "$0")/.." && pwd)"
source "$project_directory/scripts/configure-codex-runtime"

if ! command -v codex >/dev/null 2>&1; then
  echo "Codex is required for the Studio Workspace Agent. Run scripts/codespace-work to install it."
  exit 1
fi

studio_workspace_directory="${SITEFORGE_STUDIO_WORKSPACE_DIR:-$project_directory}"
billing_mode="$(node "$project_directory/scripts/runtime-ai-billing.mjs")"
declare -a codex_configuration=()

if [[ "$billing_mode" == "api_credits" ]]; then
  codex_api_key="${SITEFORGE_CODEX_API_KEY:-${OPENAI_API_KEY:-}}"
  if [[ -z "$codex_api_key" ]]; then
    echo "The Studio Codex Workspace Agent needs a server-side API key in API credits mode."
    exit 1
  fi
  export CODEX_API_KEY="$codex_api_key"
  unset OPENAI_API_KEY SITEFORGE_CODEX_API_KEY
  echo "[codex-runtime] using separately billed OpenAI API credits."
else
  login_status="$(codex --config 'forced_login_method="chatgpt"' login status 2>&1 || true)"
  if [[ ! "$login_status" =~ [Ll]ogged[[:space:]]in[[:space:]]using[[:space:]][Cc]hat[Gg][Pp][Tt] ]]; then
    echo "The Studio Codex Workspace Agent requires a ChatGPT subscription sign-in."
    echo "Run 'codex login --device-auth' in this trusted environment, then restart Studio."
    exit 1
  fi
  unset OPENAI_API_KEY SITEFORGE_CODEX_API_KEY CODEX_API_KEY
  codex_configuration+=(--config 'forced_login_method="chatgpt"')
  echo "[codex-runtime] using ChatGPT subscription access."
fi

if [[ "${SITEFORGE_RUNTIME_AUTH_REQUIRED:-0}" == "1" ]]; then
  runtime_workspaces_directory="${SITEFORGE_RUNTIME_WORKSPACES_DIR:?SITEFORGE_RUNTIME_WORKSPACES_DIR is required}"
  expected_studio_workspace="$runtime_workspaces_directory/siteforge-os"
  expected_website_workspace="$runtime_workspaces_directory/made-solid-website"
  website_workspace_directory="${MADE_SOLID_WEBSITE_DIRECTORY:?MADE_SOLID_WEBSITE_DIRECTORY is required}"
  if [[ "$studio_workspace_directory" != "$expected_studio_workspace" ||
        "$website_workspace_directory" != "$expected_website_workspace" ||
        ! "$runtime_workspaces_directory" =~ ^/[A-Za-z0-9._/-]+$ ]]; then
    echo "The Railway Codex workspace roots must be the two configured Made Solid repositories."
    exit 1
  fi
  codex_configuration+=(
    --config 'sandbox_mode="danger-full-access"'
    --config 'approval_policy="never"'
  )
fi

cd "$studio_workspace_directory"

exec codex "${codex_configuration[@]}" --strict-config app-server \
  --listen ws://127.0.0.1:4500 \
  --enable prevent_idle_sleep \
  --disable shell_snapshot
