#!/usr/bin/env bash

set -euo pipefail

runtime_data_directory="${SITEFORGE_RUNTIME_DATA_DIR:-/data}"
workspace_root="${SITEFORGE_RUNTIME_WORKSPACES_DIR:-$runtime_data_directory/workspaces}"
studio_repository="${SITEFORGE_STUDIO_REPOSITORY:-zacdagostino/made-solid-studio}"
website_repository="${SITEFORGE_WEBSITE_REPOSITORY:-zacdagostino/made-solid-website}"
github_token="${SITEFORGE_GITHUB_TOKEN:-${GITHUB_TOKEN:-}}"

if [[ -z "$github_token" ]]; then
  echo "SITEFORGE_GITHUB_TOKEN is required to prepare the two editable private repositories."
  exit 1
fi

mkdir -p "$workspace_root"
export GH_TOKEN="$github_token"

if ! gh auth status >/dev/null 2>&1; then
  echo "The configured GitHub token cannot access the Made Solid repositories."
  exit 1
fi
gh auth setup-git >/dev/null

prepare_repository() {
  local label="$1"
  local repository="$2"
  local destination="$3"

  if [[ ! -d "$destination/.git" ]]; then
    if [[ -e "$destination" ]]; then
      echo "$destination exists but is not a Git repository. Move it aside before restarting."
      exit 1
    fi
    echo "[railway-runtime] cloning the $label repository."
    gh repo clone "$repository" "$destination"
    git -C "$destination" remote set-url origin "https://github.com/$repository.git"
    return
  fi

  local current_origin
  current_origin="$(git -C "$destination" remote get-url origin 2>/dev/null || true)"
  current_origin="${current_origin#https://github.com/}"
  current_origin="${current_origin#git@github.com:}"
  current_origin="${current_origin%.git}"
  if [[ "${current_origin,,}" != "${repository,,}" ]]; then
    echo "$destination belongs to $current_origin, not $repository."
    exit 1
  fi

  if [[ -n "$(git -C "$destination" status --porcelain)" ]]; then
    echo "[railway-runtime] preserving uncommitted $label changes; automatic update skipped."
    return
  fi

  echo "[railway-runtime] refreshing the clean $label repository."
  git -C "$destination" fetch --prune origin
  local branch
  branch="$(git -C "$destination" branch --show-current)"
  if [[ -n "$branch" ]] && git -C "$destination" show-ref --verify --quiet "refs/remotes/origin/$branch"; then
    git -C "$destination" merge --ff-only "origin/$branch"
  fi
}

prepare_repository "Studio" "$studio_repository" "$workspace_root/siteforge-os"
prepare_repository "Made Solid website" "$website_repository" "$workspace_root/made-solid-website"

echo "[railway-runtime] editable repositories are ready in $workspace_root."
