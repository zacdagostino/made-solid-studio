#!/usr/bin/env bash

set -euo pipefail

runtime_data_directory="${SITEFORGE_RUNTIME_DATA_DIR:-/data}"
workspace_root="${SITEFORGE_RUNTIME_WORKSPACES_DIR:-$runtime_data_directory/workspaces}"
studio_repository="${SITEFORGE_STUDIO_REPOSITORY:-zacdagostino/made-solid-studio}"
website_repository="${SITEFORGE_WEBSITE_REPOSITORY:-zacdagostino/made-solid-website}"
github_token="${SITEFORGE_GITHUB_TOKEN:-${GITHUB_TOKEN:-}}"

mkdir -p "$workspace_root"
studio_destination="$workspace_root/siteforge-os"
website_destination="$workspace_root/made-solid-website"

repository_matches() {
  local repository="$1"
  local destination="$2"
  [[ -d "$destination/.git" ]] || return 1

  local current_origin
  current_origin="$(git -C "$destination" remote get-url origin 2>/dev/null || true)"
  current_origin="${current_origin#https://github.com/}"
  current_origin="${current_origin#git@github.com:}"
  current_origin="${current_origin%.git}"
  [[ "${current_origin,,}" == "${repository,,}" ]]
}

github_available=false
if [[ -n "$github_token" ]]; then
  export GH_TOKEN="$github_token"
  if gh auth status >/dev/null 2>&1 \
    && gh repo view "$studio_repository" >/dev/null 2>&1 \
    && gh repo view "$website_repository" >/dev/null 2>&1; then
    gh auth setup-git >/dev/null
    github_available=true
  fi
fi

if [[ "$github_available" != true ]]; then
  if ! repository_matches "$studio_repository" "$studio_destination" \
    || ! repository_matches "$website_repository" "$website_destination"; then
    echo "SITEFORGE_GITHUB_TOKEN must access both Made Solid repositories before the persistent workspaces can be prepared."
    exit 1
  fi
  echo "[railway-runtime] GitHub is unavailable; preserving both verified persistent repository checkouts without refreshing them."
fi

prepare_repository() {
  local label="$1"
  local repository="$2"
  local destination="$3"

  if [[ ! -d "$destination/.git" ]]; then
    if [[ -e "$destination" ]]; then
      echo "$destination exists but is not a Git repository. Move it aside before restarting."
      exit 1
    fi
    echo "[railway-runtime] cloning the $label repository."
    gh repo clone "$repository" "$destination"
    git -C "$destination" remote set-url origin "https://github.com/$repository.git"
    return
  fi

  if ! repository_matches "$repository" "$destination"; then
    local current_origin
    current_origin="$(git -C "$destination" remote get-url origin 2>/dev/null || true)"
    echo "$destination belongs to $current_origin, not $repository."
    exit 1
  fi

  if [[ "$github_available" != true ]]; then
    echo "[railway-runtime] preserving the $label checkout; automatic update skipped while GitHub is unavailable."
    return
  fi

  local has_uncommitted_changes=false
  if [[ -n "$(git -C "$destination" status --porcelain)" ]]; then
    has_uncommitted_changes=true
    echo "[railway-runtime] the $label checkout has uncommitted work; attempting a non-destructive fast-forward."
  else
    echo "[railway-runtime] refreshing the clean $label repository."
  fi
  git -C "$destination" fetch --prune origin
  local branch
  branch="$(git -C "$destination" branch --show-current)"
  if [[ -n "$branch" ]] && git -C "$destination" show-ref --verify --quiet "refs/remotes/origin/$branch"; then
    if ! git -C "$destination" merge --ff-only "origin/$branch"; then
      if [[ "$has_uncommitted_changes" == true ]]; then
        echo "[railway-runtime] preserving overlapping uncommitted $label changes; GitHub update deferred."
        return
      fi
      echo "The clean $label checkout could not fast-forward from origin/$branch."
      exit 1
    fi
  fi
}

prepare_repository "Studio" "$studio_repository" "$studio_destination"
prepare_repository "Made Solid website" "$website_repository" "$website_destination"

echo "[railway-runtime] editable repositories are ready in $workspace_root."
